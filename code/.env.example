# 复制本文件为 .env（同目录），填入你自己的值；.env 不会被提交到 git。
# 或者：不使用 .env，直接把值写进每个脚本顶部的配置区。

# --- LLM（OpenAI 兼容 API）---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_ID=qwen3.8:27b-mlx

# --- 联网搜索（实战篇 P1-P3 用，任选其一）---
# 注册 Parallel：https://platform.parallel.ai（每月 $5 免费额度）
PARALLEL_API_KEY=填入你的-key
# 注册 Exa：https://dashboard.exa.ai（注册送免费额度）
EXA_API_KEY=填入你的-key
# 默认搜索服务：exa 或 parallel
WEBSEARCH_PROVIDER=parallel
